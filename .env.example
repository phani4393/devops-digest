# DevOps Digest configuration — everything here is optional.
# The default run is 100% free and needs NO keys. Telegram is optional.

# ----------------------------------------------------------------------------
# Telegram delivery (optional but recommended)
# Create a bot via @BotFather to get the token.
# Get your chat ID by messaging @userinfobot on Telegram.
# Without these, the digest is still written to the markdown archive.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ----------------------------------------------------------------------------
# Summarizer: "extractive" (default, free, no deps) or "ollama" (free, local)
# ----------------------------------------------------------------------------
DD_SUMMARIZER=extractive
DD_SUMMARY_SENTENCES=2
# Only used when DD_SUMMARIZER=ollama (run `ollama serve` locally):
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ----------------------------------------------------------------------------
# Selection tuning (all optional — sensible defaults in src/config.py)
# ----------------------------------------------------------------------------
# DD_LOOKBACK_HOURS=168     # how far back to consider (default: 1 week)
# DD_MAX_PER_TOPIC=5        # items per lane in the digest
# DD_MIN_RELEVANCE=1.0      # minimum score to include
# DD_HN_STORY_LIMIT=120     # how many HN top stories to scan

# ----------------------------------------------------------------------------
# Output locations (optional)
# ----------------------------------------------------------------------------
# DD_ARCHIVE_DIR=archive
# DD_SEEN_STATE_FILE=state/seen.json

# ----------------------------------------------------------------------------
# LinkedIn autoposter handoff (optional)
# Writes feed/linkedin-feed.json in the autoposter's TopicSuggestion shape.
# ----------------------------------------------------------------------------
# DD_LINKEDIN_FEED=true
# DD_LINKEDIN_FEED_DIR=feed
